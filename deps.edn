{:paths ["src" "resources"]
 :deps {org.clojure/clojure {:mvn/version "1.12.6"}
        org.clojure/tools.cli {:mvn/version "1.4.256"}
        yogthos/config {:mvn/version "1.2.0"}
        io.github.tonsky/toml-clj {:mvn/version "0.1.0"}}
 :aliases
 {:repl {:main-opts ["-e" "(do (require 'selfdidactic.cli) (in-ns 'selfdidactic.cli) nil)"
                      "-r"]}
  :run-m {:main-opts ["-m" "selfdidactic.switchyard"]}
  :build {:extra-paths ["src"]
          :deps {io.github.clojure/tools.build
                 {:mvn/version "0.10.14"}}
          :ns-default build}
  :test {:extra-paths ["test"]
         :extra-deps {org.clojure/test.check {:mvn/version "1.1.3"}
                      io.github.cognitect-labs/test-runner {:git/tag "v0.5.1" :git/sha "dfb30dd"}}}}}
