{:harnesses
 {:hermes
  {:command "hermes"
   :model {:parameter "-m"}
   :skill {:parameter "--skills"
           :plural true}}

  :opencode
  {:command "opencode"
   :model {:parameter "-m"}
   :extra-params ["--auto"]}

  :claude
  {:command "claude"
   :plugin :switchyard.agent/claude}

  :kiro
  {:command "kiro-cli"
   :plugin :switchyard.agent/kiro}}}
